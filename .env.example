# MongoDB Configuration
MONGO_IMAGE=mongo:7.0
MONGO_CONTAINER_NAME=mongo
MONGO_PORT=27017
MONGO_INITDB_DATABASE=rideflow

# Redis Configuration
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_NAME=redis
REDIS_PORT=6379

# Compass Web (MongoDB Web UI) Configuration
COMPASS_IMAGE=haohanyang/compass-web:latest
COMPASS_CONTAINER_NAME=compass-web
COMPASS_PORT=8085
CW_MONGO_URI=mongodb://mongo:27017

# Mailpit (Email Testing) Configuration
MAILPIT_IMAGE=axllent/mailpit:latest
MAILPIT_CONTAINER_NAME=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

